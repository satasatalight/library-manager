{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "install:clean": "node -e \"fs.rmSync('node_modules', { recursive: true, force: true }); fs.rmSync('package-lock.json', { force: true })\" && npm i",
    "dev": "node --env-file=./.env --watch src/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "node --env-file-if-exists=./.env src/server.ts",
    "test": "node --env-file=./.env --test --test-concurrency=1",
    "typecheck": "tsc -b --noEmit"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-zod-safe": "^3.2.1",
    "jet-logger": "3.0.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/connect-livereload": "^0.6.3",
    "@types/express": "^5.0.6",
    "@types/livereload": "^0.9.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "connect-livereload": "^0.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "jiti": "^2.7.0",
    "livereload": "^0.10.3",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
